# ============ API ============
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============ Seguridad ============
JWT_SECRET=cambia_este_secreto_largo
VALIDA_CURP_TOKEN=pruebas

# ============ Base de datos ============
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ============ Pasarela WhatsApp (Evolution API) ============
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8080
WHATSAPP_INSTANCE_NAME=mediprotect
WHATSAPP_GATEWAY_APIKEY=

# ============ Seguridad webhook entrante ============
# Header x-mediprotect-apikey requerido en /whook/wame (dejar vacío para no exigir)
WHATSAPP_WEBHOOK_APIKEY=cambia_esta_clave_webhook
# IPs permitidas para recibir webhooks (vacío = solo localhost)
WHATSAPP_WEBHOOK_ALLOWED_IPS=127.0.0.1

# ============ Notificaciones Push ============
VAPID_PUBLIC_KEY=BE8PbPyCNWpbe0iBTusqGluzp0BNN03PSwHBs3HCyCQqsxLHFltHrfxGghsNdiVTzdZpsPAEJMdTjj5o7DWIffM
VAPID_PRIVATE_KEY=cambia_esta_clave_privada_vapid

# ============ Email (Brevo) ============
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=tu_usuario_smtp
EMAIL_SMTP_PASS=tu_password_smtp
EMAIL_FROM=noreply@mediprotect.com.mx